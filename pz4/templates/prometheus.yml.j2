global:
  scrape_interval: 1s
  evaluation_interval: 1s
  scrape_timeout: 1s
  external_labels:
    monitor: 'usoltsev-project'

scrape_configs:
  - job_name: "nginx"
    static_configs:
      - targets: ["0.0.0.0:9114"]
    metrics_path: "/metrics"
    scrape_interval: 1s
  - job_name: zeek
    metrics_path: "/metrics"
    scheme: http
    static_configs:
      - targets: ['127.0.0.1:4242']
alerting:
  alertmanagers:
  - static_configs:
    - targets: ['localhost:9093']
rule_files:
  - alert.rules.yml


