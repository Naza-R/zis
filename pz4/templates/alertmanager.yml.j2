global:
  resolve_timeout: 5m


route:
  group_by: ['alertname']
  group_wait: 3s
  group_interval: 5s
  repeat_interval: 1h
  receiver: 'telegram'

receivers:
- name: 'telegram'
  telegram_configs:
  -  bot_token: '{{ telegram_bot_token }}'
     api_url: 'https://api.telegram.org'
     chat_id: {{ telegram_chat_id }}
     parse_mode: 'HTML'
